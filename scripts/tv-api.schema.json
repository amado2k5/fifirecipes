{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FiFi Recipes TV data API",
  "description": "Shape of every file under public/data/tv/. scripts/generate-tv-index.ts validates each generated file against the matching entry in `definitions` before it is written. See docs/tv-api.md.",
  "definitions": {
    "manifest": {
      "type": "object",
      "required": ["version", "generatedAt", "recipeCount", "pageSize", "languages", "endpoints"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "minLength": 1 },
        "recipeCount": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "nativeName", "englishName", "dir", "complete"],
            "additionalProperties": false,
            "properties": {
              "code": { "type": "string", "minLength": 2 },
              "nativeName": { "type": "string", "minLength": 1 },
              "englishName": { "type": "string", "minLength": 1 },
              "dir": { "enum": ["ltr", "rtl"] },
              "complete": { "enum": [true] }
            }
          }
        },
        "endpoints": {
          "type": "object",
          "required": ["index", "feed", "chapters", "kids", "recipe", "i18n", "search", "videos", "kidsRecipe", "images"],
          "additionalProperties": false,
          "properties": {
            "index": { "type": "string", "pattern": "\\{lang\\}" },
            "feed": { "type": "string", "pattern": "\\{lang\\}" },
            "chapters": { "type": "string", "pattern": "\\{lang\\}" },
            "kids": { "type": "string", "pattern": "\\{lang\\}" },
            "recipe": { "type": "string", "pattern": "\\{id\\}" },
            "i18n": { "type": "string", "pattern": "\\{lang\\}" },
            "search": { "type": "string", "pattern": "\\{lang\\}" },
            "videos": { "type": "string", "pattern": "\\{id\\}" },
            "kidsRecipe": { "type": "string", "pattern": "\\{lang\\}.*\\{id\\}" },
            "images": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "hasVideo", "chapter", "chapterName"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "titleEn": { "type": "string" },
          "category": { "type": "string", "minLength": 1 },
          "cookingMethod": { "type": "string" },
          "prepTime": { "type": "string" },
          "cookTime": { "type": "string" },
          "servings": { "type": "string" },
          "difficulty": { "enum": ["easy", "medium", "master"] },
          "image": { "type": "string", "minLength": 1 },
          "hasVideo": { "type": "boolean" },
          "chapter": { "type": "integer" },
          "chapterName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feed": {
      "type": "object",
      "required": ["rows"],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "title", "items"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "recipeCount"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "minLength": 1 },
          "recipeCount": { "type": "integer" },
          "coverImage": { "type": "string" }
        }
      }
    },
    "kids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "group", "ages", "minutes", "noCook", "cover"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "group": { "enum": ["breakfast", "snack", "savoury", "sweet", "drink"] },
          "ages": { "enum": ["3-5", "6-8", "9+"] },
          "minutes": { "type": "number" },
          "noCook": { "type": "boolean" },
          "cover": { "type": "string", "minLength": 1 }
        }
      }
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["card", "full", "w", "h"],
        "additionalProperties": false,
        "properties": {
          "card": { "type": "string", "pattern": "^/" },
          "card2x": { "type": "string", "pattern": "^/" },
          "full": { "type": "string", "pattern": "^/" },
          "full2x": { "type": "string", "pattern": "^/" },
          "w": { "type": "integer" },
          "h": { "type": "integer" }
        }
      }
    }
  }
}
