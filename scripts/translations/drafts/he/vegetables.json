  "fah-160": {
    "_ar": {
      "title": "بانيه الأرنبيط المقرمش",
      "category": "خضروات",
      "method": "تسبيك",
      "prep": "20 دقيقة",
      "cook": "30 دقيقة",
      "servings": "4 أفراد",
      "notes": "لا تبططي الأرنبيط عند تغليفه بالخليط الجاف، بل اعمليه بشكل عشوائي لكي يبقى مقرمشًا. يمكنك حفظ الأرنبيط المغلف في الفريزر قبل القلي واستخدامه لاحقًا.",
      "siteMatch": "meat-23",
      "ingredients": [
        "1 حبة أرنبيط",
        "2 كوب دقيق",
        "1/2 كوب نشا",
        "2 حبة بيض",
        "1 ملعقة صغيرة توم مفروم",
        "حسب الرغبة بقدونس",
        "حسب الرغبة ملح",
        "حسب الرغبة فلفل",
        "1 ملعقة صغيرة كمون",
        "حسب الرغبة بابريكا",
        "حسب الرغبة توم بودر",
        "1 ملعقة صغيرة باكينج باودر",
        "حسب الرغبة زيت للقلي"
      ],
      "steps": {
        "1": "اغسل الأرنبيط جيدًا وقطّعه إلى زهرات صغيرة.",
        "2": "أضف الماء إلى القدر واتركه حتى يغلي، ثم أضف ملعقة كبيرة من الملح وملعقة صغيرة من الكمون.",
        "3": "انزل الأرنبيط في الماء المغلي واتركه حتى يسلق قليلاً، ثم صفيه وانقله إلى ماء بارد لوقف عملية التسوية.",
        "4": "اخلط الدقيق والنشا والبهارات (الملح، الفلفل، الكمون، البابريكا، التوم بودر، الباكينج باودر) في وعاء.",
        "5": "أضف البيض المخفوق، التوم المفروم، والبقدونس إلى نصف الخليط الجاف، ثم أضف الماء تدريجيًا مع التقليب حتى يصبح القوام مشابهًا لقوام البانكيك.",
        "6": "اغمس زهرات الأرنبيط في الخليط السائل، ثم اغمسها في الخليط الجاف.",
        "7": "احمر الأرنبيط في زيت ساخن على نار متوسطة حتى يصبح ذهبي اللون ومقرمش.",
        "8": "قدم البانيه الأرنبيط على فرشة من البقدونس والبقدونس المفروم."
      }
    },
