  "fah-159": {
    "_ar": {
      "title": "باذنجان بدون زيت",
      "category": "خضروات",
      "method": "تسبيك",
      "prep": "20 دقيقة",
      "cook": "10 دقائق",
      "servings": "4 أفراد",
      "notes": "هذا الطبق فاتح للشهية ويمكن تقديمه لوحده أو مع الكشري أو البطاطس والفول. يمكن استخدامه أيضًا كجزء من وجبة الفطور.",
      "siteMatch": "veg-24",
      "ingredients": [
        "حسب الرغبة باذنجان رومي",
        "حسب الرغبة فلفل",
        "معلقة كبيرة ملح",
        "معلقتان كبيرتان خل",
        "شوية زيت زيتون",
        "شوية مفرومة كسبرة خضراء"
      ],
      "steps": {
        "1": "قطع الباذنجان الرومي إلى مكعبات متوسطة الحجم.",
        "2": "قطع الفلفل إلى قطع كبيرة، يمكنك استخدام الفلفل الحار أو البارد حسب الرغبة.",
        "3": "أعد حلة بها ماء مغلي، أضف ملعقة كبيرة من الملح ومعلقتين كبيرتين من الخل.",
        "4": "أضف الباذنجان والفلفل إلى الماء المغلي، غطِّ الحلة واتركها لمدة 10 دقائق.",
        "5": "بعد 10 دقائق، صفي الباذنجان والفلفل في مصفاة لتصريف الماء الزائد.",
        "6": "ضع الباذنجان والفلفل في طبق، أضف شوية زيت زيتون وكسبرة خضراء مفرومة.",
        "7": "قلب المكونات معًا جيدًا.",
        "8": "أضف شوية خل وقلب مرة أخرى."
      }
    },
