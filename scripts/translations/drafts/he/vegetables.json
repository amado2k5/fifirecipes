{
  "fah-158": {
    "_ar": {
      "title": "الخرشوف بالبشاميل",
      "category": "خضروات",
      "method": "فرن",
      "prep": "20 دقيقة",
      "cook": "30 دقيقة",
      "servings": "4 أفراد",
      "notes": "يمكن تخزين الخرشوف المغلي في الفريزر لفترة طويلة. يمكن تقديم الطبق ساخناً مع سلطة خضراء.",
      "siteMatch": "osool-506",
      "ingredients": [
        "حسب الرغبة خرشوف",
        "1 كيلو لحمة مفرومة",
        "1/2 كيلو بصل",
        "حسب الرغبة ملح",
        "حسب الرغبة فلفل",
        "حسب الرغبة سكر",
        "حسب الرغبة قرفة",
        "1 ملعقة صغيرة بهارات سبعة",
        "2 ملعقة كبيرة سمنة أو زيت",
        "5 ملاعق كبيرة دقيق",
        "4 قطع جبن كيري",
        "1 كوب كريمة",
        "1 كيلو لبن سائع",
        "حسب الرغبة جزء الطيب",
        "1 مكعب مرقة",
        "3 ملاعق كبيرة سمنة أو زبدة",
        "1 ملعقة كبيرة أشتة",
        "2 ملعقة كبيرة لبن"
      ],
      "steps": {
        "1": "اغسل الخرشوف وقشره باستخدام سكينة حادة، ثم ازيل القلب الداخلي بالملعقة.",
        "2": "انقع الخرشوف في الماء المغلي لمدة 3 دقائق، ثم اغسله بالماء البارد للتخزين.",
        "3": "في طاسة على النار، اذبب السمنة أو الزيت، ثم أضف البصل المفروم وشوحه حتى يصبح لونه ذهبياً.",
        "4": "أضف اللحمة المفرومة وقلّبها جيداً، ثم أضف الملح، الفلفل، السكر، القرفة، والبهارات السبعة وقلّبها جيداً.",
        "5": "في حلة على النار، اذبب السمنة أو الزبدة، ثم أضف الدقيق وقلّبه جيداً حتى يصبح لونه أبيض.",
        "6": "أضف اللبن السائع تدريجياً مع التحريك المستمر، ثم أضف الملح، الفلفل، جزء الطيب، الجبن الكيري، والكريمة وقلّبها جيداً.",
        "7": "ادهن طاجن بسمنة أو زبدة، ثم احشي الخرشوف باللحمة المعصجة ورتبها في الطاجن.",
        "8": "صب البشاميل فوق الخرشوف، ثم أضف خليط الأشتة واللبن على الوجه.",
        "9": "ادخل الطاجن إلى الفرن المسخن مسبقاً على درجة حرارة عالية حتى يحمر الوجه."
      }
    },
