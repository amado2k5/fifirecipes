  "fah-185": {
    "_ar": {
      "title": "كبيبة اقتصادية",
      "category": "محشوات",
      "method": "قلي",
      "prep": "60 دقيقة",
      "cook": "30 دقيقة",
      "servings": "40 كبيبة",
      "notes": "يمكن حفظ الكبيبات في الفريزر بعد تشكيلها وتركها في الثلاجة لمدة نصف ساعة. عند القلي، تأكد من أن الزيت ساخن جيدًا لتجنب امتصاص الزيت.",
      "siteMatch": "meat-40",
      "ingredients": [
        "2 كوب برغل",
        "1.5 كوب دقيق",
        "1.5 كوب مفروم بصل",
        "0.5 كوب زيت",
        "1 ملعقة كبيرة ملح",
        "1 ملعقة صغيرة فلفل أسود",
        "1 ملعقة صغيرة بهارات سبعة",
        "0.5 ملعقة صغيرة نعناع ناشف",
        "0.5 كيلو لحم مفروم",
        "1 ملعقة كبيرة سمنة",
        "حسب الرغبة بقدونس",
        "حسب الرغبة مكسرات (سوداني، بندق، صنوبر)"
      ],
      "steps": {
        "1": "اطحن البرغل حتى يصبح ناعمًا.",
        "2": "أضف 3 أكواب من الماء المغلي إلى البرغل المطحون، اقلب وغطي، واتركه لمدة ساعة إلى ربع ساعة.",
        "3": "أعد الحشوة: في وعاء آخر، ضع كيلو من اللحم المفروم، 1.5 كوب من البصل المفروم، ملح، فلفل أسود، بهارات سبعة، وقلّب.",
        "4": "سخن ملعقة كبيرة من السمنة في مقلاة، أضف البصل المفروم وقلّب حتى يصبح ذهبيًا، ثم أضف اللحم وقلّب حتى ينضج.",
        "5": "أضف الملح والبهارات إلى اللحم، وقلّب جيدًا.",
        "6": "احمر المكسرات في ملعقة صغيرة من الزيت حتى تصبح ذهبية، ثم أضفها إلى الحشوة.",
        "7": "بعد أن يبرد البرغل، أضف الدقيق، النعناع الناشف، الفلفل الأسود، بهارات سبعة، البصل المفروم، الملح، والزيت، واعجن حتى تصبح العجينة ناعمة وغير لاصقة.",
        "8": "شكل الكبيبات: ابلل يديك بالزيت، خذ جزءًا من العجينة، اعمل فتحة في الوسط، ضع الحشوة، وأغلق الكبيبة جيدًا.",
        "9": "رتب الكبيبات في صينية، واتركها في الثلاجة لمدة نصف ساعة قبل القلي.",
        "10": "اقلي الكبيبات في زيت ساخن على نار متوسطة حتى تصبح ذهبية اللون."
      }
    },
