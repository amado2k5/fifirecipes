  "fah-184": {
    "_ar": {
      "title": "طاجن ورق عنب باللحمة",
      "category": "محشوات",
      "method": "تسبيك",
      "prep": "20 دقيقة",
      "cook": "40 دقيقة",
      "servings": "4 أفراد",
      "notes": "تأكد من أن ورق العنب ناعم ولونه فاتح، ورصيه بشكل صحيح في الطاجن لضمان عدم فكه. يمكنك إضافة شرائح البطاطس للحصول على طبق أكثر كثافة.",
      "siteMatch": "stuff-08",
      "ingredients": [
        "حسب الرغبة ورق العنب",
        "2 كوب الرز",
        "2 كوب الصلصة",
        "1 كوب الخضرة",
        "2 حبة البصل",
        "حسب الرغبة التوابل (ملح، فلفل، كمون، كسبارة، بهارات سابعة، رشة سكر)",
        "حسب الرغبة اللحمة",
        "رشة الحبهان",
        "رشة الفلفل الأصفر",
        "2 ملعقة كبيرة الدبس الرمان",
        "2 حبة عصير الليمون",
        "حسب الرغبة الزيت",
        "2 فص الثوم",
        "1 ورقة ورقة الغار",
        "حسب الرغبة الزبادي",
        "1 حبة الخيار",
        "حسب الرغبة النعناع"
      ],
      "steps": {
        "1": "اختاري ورق العنب الناعم واللون الفاتح، شيليه الساق وغسله ورصيه فوق بعضه في نفس الاتجاه.",
        "2": "ضعي ورق العنب في حلة صغيرة على النار مع الملح والكمون وملعقتين زيت، ثم اغليه وقلبيه.",
        "3": "في وعاء، اخلطي الرز، الصلصة، الخضرة، البصل المفروم، والتوابل.",
        "4": "في حلة على النار، ضعي فص ثوم وورقة غار، ثم أضيفي اللحمة المقطعة مكعبات صغيرة وشوحها حتى تأخذ لونًا ذهبيًا.",
        "5": "أضيفي الحبهان والفلفل الأصفر والملح والسكر، ثم غطيها واتركيها تستوي.",
        "6": "اشربي اللحمة في ورق العنب مع الرز، ثم ضعيها في الطاجن.",
        "7": "أضيفي شرائح الطماطم والبصل والبطاطس والخضرة والثوم، ثم ضعي ورق العنب المتبقي على الوجه.",
        "8": "أضيفي الشربة الساخنة والدبس الرمان وعصير الليمون، ثم هزي الحلة جيدًا.",
        "9": "غطي الطاجن بطبق لضمان عدم فك الورق، ثم اتركيه على نار هادئة حتى يستوي.",
        "10": "أعدِّي سلطة الزبادي بالخيار والنعناع والملح والزيت."
      }
    },
