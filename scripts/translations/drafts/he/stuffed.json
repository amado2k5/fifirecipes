        "1 حبة كرافس",
        "1 ورقة ورق لورا",
        "1 عود قرفة",
        "1 حبة حبة هيل",
        "1 رشة مستكة",
        "1 رشة فلفل أسود"
      ],
      "steps": {
        "1": "اغسل الطماطم الحمراء وقطّعها إلى قطع صغيرة.",
        "2": "أضف الفلفل الأحمر الحار والفلفل الرومي إلى الطماطم.",
        "3": "اخلط جميع المكونات في الخلاط حتى تصبح ناعمة.",
        "4": "سخن السمنة في قدر على النار، ثم أضف المزيج المخلوط وقلّبه جيدًا.",
        "5": "أضف مكعب المرقة والسكر وصلصة الطماطم، ثم اتركه على النار لمدة دقائق.",
        "6": "اغسل الخضرة (البصل، الشبت، البقدونس، الكسبرة) وقطّعها رفيعًا.",
        "7": "اخلط الخضرة مع الملح والفلفل الأسود والكمون والبهارات السبعة والقرفة.",
        "8": "ادعك البصل مع البهارات جيدًا.",
        "9": "أضف الرز المغسول والمصفى إلى الخليط، ثم أضف الزيت وقلّب جميع المكونات معًا.",
        "10": "نظف المنبار بالملح الخشن والكربونات الصوديوم والخل، ثم اغسله بالماء.",
        "11": "احشي المنبار بالخلطة، مع ترك جزء من النهاية فارغًا.",
        "12": "أضف الماء المغلي إلى القدر مع البصل، الجزر، الطماطم، الثوم، الكرافس، الورق اللورا، القرفة، الحبة الهيل، المستكة، والفلفل الأسود.",
        "13": "أضف المنبار إلى القدر، ثم غطيه واتركه على نار عالية حتى يغلي، ثم خفّض النار واتركه لمدة ساعة.",
        "14": "صفي المنبار، ثم احمّره في مقلاة بها السمنة والزيت.",
        "15": "أضف البهارات (الملح، الكمون، الكسبرة، الشطة، الفلفل الأسود) إلى المنبار وهو ساخن، ثم قلّبهم معًا."
