  "fah-786": {
    "_ar": {
      "title": "4 مشروبات شتوية سهلة وسريعة",
      "category": "مشروبات",
      "method": "حفظ وتجميد",
      "prep": "20 دقيقة",
      "cook": "10 دقائق",
      "servings": "4 أفراد",
      "notes": "احفظي بودرة السحلب والهوت شوكولات في برطمانات محكمة ونظيفة وناشفة. يمكنك إضافة المكسرات على وجه السحلب للحصول على طعم مقرمش.",
      "ingredients": [
        "2 كوب عصير التفاح بدون سكر",
        "2 عود قرفة",
        "1/2 قطعة نجمة بادنجان",
        "2 شريحة شرائح برتقال",
        "1/2 كوب دقيق الرز",
        "1/2 كوب سكر بودرة",
        "1/2 كوب لبن بودرة",
        "1/2 كوب جزهند ناعم",
        "2 ملعقة كبيرة نشا",
        "2 ملعقة كبيرة سمسم محمص",
        "1/2 كوب زبيب",
        "1 باكت فانيليا بودرة",
        "1 كوب سكر بودرة",
        "1/2 كوب كاكاو",
        "1/2 كوب شوكولات شبس",
        "1 كوب حليب",
        "1 ملعقة كبيرة كاسترد",
        "1 ملعقة صغيرة سكر",
        "2 فص حبة هان",
        "حسب الرغبة جست الهند",
        "حسب الرغبة مرشميلو"
      ],
      "steps": {
        "1": "تحضير الهوت سيدر: اخلطي عصير التفاح، القرفة، نجمة بادنجان، وشرائح البرتقال في وعاء. اغلي المزيج على النار حتى تختلط النكهات.",
        "2": "تحضير بودرة السحلب: اخلطي دقيق الرز، السكر البودرة، اللبن البودرة، الجزهند الناعم، النشا، السمسم المحمص، الزبيب، والفانيليا بودرة في وعاء كبير. احفظي المزيج في برطمان محكم.",
        "3": "تحضير السحلب: اخلطي كوب حليب مع ملعقة كبيرة من بودرة السحلب على البارد. ارفعي المزيج على النار وقلبي حتى يغلي. صب السحلب في الأكواب وقدميه.",
        "4": "تحضير بودرة الهوت شوكولات: اخلطي السكر البودرة، الكاكاو، اللبن البودرة، النشا، والشوكولات شبس في وعاء. احفظي المزيج في برطمان محكم.",
        "5": "تحضير الهوت شوكولات: اخلطي كوب حليب مع ملعقة كبيرة من بودرة الهوت شوكولات على البارد. ارفعي المزيج على النار وقلبي حتى يغلي. صب الهوت شوكولات في الأكواب وقدميه مع المرشميلو.",
        "6": "تحضير الكاسترد: اخلطي كوب حليب مع ملعقة كبيرة من الكاسترد وملعقة صغيرة من السكر وفصين حبة هان. ارفعي المزيج على النار وقلبي حتى يغلي ويتكاثف. صب الكاسترد في الأكواب وزينه بجست الهند."
      }
    },
