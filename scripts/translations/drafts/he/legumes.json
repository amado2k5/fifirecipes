      "servings": "حسب الرغبة",
      "notes": "احفظي الترمس والحمص والفول في التلاجة لمنع تغير الطعم وظهور الرغوة. عند أخذه من التلاجة، استخدمي ملعقة نظيفة وجافة. إذا ظهرت رغوة، صفي المياه واستبدليها بمياه نظيفة مع إضافة ملعقة صغيرة من الملح لكل كوب.",
      "ingredients": [
        "حسب الرغبة ترمس",
        "حسب الرغبة حمص",
        "حسب الرغبة فول",
        "حسب الحاجة ماء",
        "حسب الحاجة ملح"
      ],
      "steps": {
        "1": "اغسلي الترمس والحمص والفول وانقيهم جيدًا.",
        "2": "انقعي الترمس والحمص في ماء مغلي لمدة 3 ساعات.",
        "3": "احمصي الفول في طاسة فارغة على نار متوسطة مع التقليب المستمر حتى يتحمص.",
        "4": "أعدي محلول ملحي بخلط 3 كؤوس ماء مغلي مع ملعقة كبيرة ملح لكل كوب.",
        "5": "انقعي الفول في المحلول الملحي لمدة 3 ساعات.",
        "6": "صفي الترمس والحمص من ماء النقع وضعيهم في ماء مغلي جديد.",
        "7": "اطهي الترمس والحمص على نار هادئة لمدة ساعة ونصف.",
        "8": "صفي الترمس والحمص وانقعيهم في محلول ملحي مبرد لمدة 2 ساعات.",
        "9": "احفظي الترمس والحمص والفول في التلاجة.",
        "10": "قدمي الترمس والحمص والفول مع الكمون والشطة والليمون."
      }
    },
