        "رشة حبهان بودرة",
        "كوب كريمة",
        "معلقة كبيرة سمنة"
      ],
      "steps": {
        "1": "سخن السمنة في قدر على النار.",
        "2": "أضف البصل المفروم وقلبه حتى يصبح لونه ذهبيًا.",
        "3": "أضف قطع الفراخ وشوحها مع البصل حتى تبدأ في النضج.",
        "4": "أضف الفلفل، السكر، الملح، وحبهان البودرة وقلبه جيدًا.",
        "5": "أضف المشروم وشوحه مع الفراخ والبصل لمدة دقيقة.",
        "6": "أضف الدقيق وقلب الخليط جيدًا.",
        "7": "أضف لتر من الماء واتركه يغلي لمدة دقيقتين.",
        "8": "أضف الكريمة واتركها تغلي لمدة دقيقة ثم اطفئ النار.",
        "9": "جمع الكريمة من وجه اللبن إذا كنت ترغب في استخدام بديل للكريمة"
      }
